{
  "name": "futurefunded",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "ff:check": "npm run lint && tsc --noEmit && git diff --check",
    "ff:test:organizer": "node --test tests/cli/organizer.test.mjs",
    "ff:test:security": "node --test tests/cli/security.test.mjs",
    "ff:test:organizer:e2e:smoke": "playwright test organizer-security.spec.ts",
    "ff:auth:capture": "playwright test organizer-auth.capture.spec.ts --headed",
    "ff:test:organizer:authenticated": "playwright test organizer-authenticated.spec.ts",
    "ff:test:organizer:workflow": "playwright test organizer-workflow.spec.ts --workers=1",
    "ff:test:organizer:signout": "playwright test organizer-signout.spec.ts --workers=1"
  },
  "dependencies": {
    "better-auth": "^1.7.7",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "qrcode.react": "4.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.34.1",
    "server-only": "0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "typescript": "^5"
  }
}
